{
  "name": "aios-designer-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS Designer MVP Foundation",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@aios-designer/*\" dev",
    "dev:daemon": "pnpm --filter @aios-designer/daemon dev",
    "dev:web": "pnpm --filter @aios-designer/web dev",
    "build": "pnpm --filter \"@aios-designer/*\" build",
    "test": "pnpm --filter \"@aios-designer/*\" test"
  },
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
